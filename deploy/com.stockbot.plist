<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Starts the bot when you log in and restarts it if it crashes.
    cp deploy/com.stockbot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.stockbot.plist
  Stop:  launchctl unload ~/Library/LaunchAgents/com.stockbot.plist
  Logs:  data/bot.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockbot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/vinyas/playground/stock-bot/run.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/vinyas/playground/stock-bot/data/bot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vinyas/playground/stock-bot/data/bot.log</string>
</dict>
</plist>
