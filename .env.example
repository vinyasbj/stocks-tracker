# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated. Leave empty on first run, send /start to the bot, and paste the id it replies with.
ALLOWED_CHAT_IDS=

# On the server, docker-compose.yml sets OLLAMA_URL (the shared expense-ollama container) and DB_PATH,
# overriding anything here, so leave both out of the server's .env.
OLLAMA_URL=http://localhost:11434
# Keep model and context the same as expense-tracker's (qwen2.5:7b, 8192) so one loaded copy serves both bots.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
# Seconds one model call may take before the bot gives up and replies with an error. The server's CPU is
# slower than a Mac: /why took 28-53 s there (slowest 53 s), so 90 s. See README, "Run on the server".
OLLAMA_TIMEOUT=90

# SEC requires a contact in the User-Agent: "<app name> <your email>"
SEC_USER_AGENT=stock-bot you@example.com

# Notion: the portfolio and wishlist the bot tracks (read-only).
# 1. notion.so/profile/integrations -> New integration (internal) -> copy the token here.
# 2. In each database: ... -> Connections -> add the integration.
NOTION_TOKEN=
NOTION_PORTFOLIO_DB=https://www.notion.so/...
NOTION_WISHLIST_DB=https://www.notion.so/...
# Your conviction blueprint: import templates/blueprint.csv into Notion, share it with the integration,
# paste its link here, then review with /blueprint and lock with /blueprint lock.
NOTION_BLUEPRINT_DB=
# Market for rows without an Exchange column: IN or US (leave empty to infer from the ticker)
NOTION_PORTFOLIO_MARKET=
NOTION_WISHLIST_MARKET=
# Only needed if your column names are not detected automatically:
# NOTION_COL_TICKER=Ticker
# NOTION_COL_NAME=Name
# NOTION_COL_EXCHANGE=Exchange
# NOTION_COL_QTY=Qty
# NOTION_COL_AVG_PRICE=Avg price

POLL_MINUTES=15
# false: alerts carry only exchange/SEC filings and regulator releases, no news stories
NEWS_ALERTS=true
# Daily portfolio/wishlist digest, Asia/Kolkata time
DIGEST_TIME_IST=08:30
DB_PATH=data/stockbot.db

# Optional dead-man's switch: pinged after every monitor pass (and <url>/fail when a pass fails).
# Create a free check at healthchecks.io (period 15 min, grace 30 min) and paste its ping URL.
# When the pings stop, because the bot hung or the server is down, healthchecks.io alerts you.
HEARTBEAT_URL=
